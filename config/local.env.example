# Copy to config/local.env (git-ignored) and override any value from
# config/defaults.env for this machine only. Examples:
# ADX_EMU_GPU="software"
# ADX_EMU_HEADLESS="false"
# ADX_APPS_DIR="$HOME/code/android"
# ADX_SDK_EXTRA_PACKAGES="build-tools;36.0.0 platforms;android-36"
# ADX_MCP_SCOPE="project"
# Hybrid Intel + NVIDIA laptops: run only the emulator on the NVIDIA GPU.
# ADX_EMU_ENV="__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only"
