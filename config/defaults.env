# adx defaults — committed. Override any value in config/local.env (git-ignored).
# Values may reference earlier ones. Versions verified 2026-11-05.

# --- Paths ---------------------------------------------------------------
ANDROID_HOME="$HOME/Android/Sdk"
ADX_DOWNLOADS="$HOME/Downloads/adx"
ADX_APPS_DIR="$HOME/projects/android-apps"

# --- Logs ----------------------------------------------------------------
ADX_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/adx"   # adx.log + emulator-<avd>.log
ADX_LOG_MAX_KB="5120"        # rotate adx.log above this size
ADX_LOG_KEEP="5"             # rotated adx.log.N / previous emulator logs kept

# --- JDK (Gradle/AGP; user-level Temurin, installed by the jdk module) ---
ADX_JDK_MAJOR="21"
ADX_JAVA_HOME="$HOME/.local/opt/jdk-$ADX_JDK_MAJOR"

# --- Android SDK ---------------------------------------------------------
ADX_CMDLINE_TOOLS_BUILD="16111833"
# SHA-256 of commandlinetools-linux-<build>_latest.zip. Derived 2026-11-06 from a download that
# matched the SHA-1 in https://dl.google.com/android/repository/repository2-3.xml. Update with the build.
ADX_CMDLINE_TOOLS_SHA256="0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8"
ADX_SDK_PLATFORM="android-37.0"
ADX_SDK_BUILD_TOOLS="37.0.0"
ADX_SDK_EXTRA_PACKAGES=""   # space-separated extra sdkmanager package paths

# --- Emulator ------------------------------------------------------------
ADX_AVD_NAME="adx_api37"
ADX_AVD_DEVICE="pixel_8"
ADX_AVD_IMAGE="system-images;android-37.0;google_apis_playstore;x86_64"
ADX_AVD_HW_KEYBOARD="yes"   # yes = the host keyboard types into the emulator (avdmanager defaults to no)
ADX_EMU_GPU="host"           # host | auto | software (Lavapipe, emulator 36.4.9+). The emulator
                             # module sets software on hybrid Intel/AMD + NVIDIA laptops (see docs)
ADX_EMU_HEADLESS="true"      # true = -no-window, false = show a window
ADX_EMU_BOOT_TIMEOUT="240"   # seconds
ADX_EMU_PORT="5554"          # console port; adb serial is emulator-<port>
ADX_EMU_ENV=""               # extra VAR=value pairs for the emulator process only,
                             # e.g. NVIDIA PRIME offload on hybrid laptops (see docs/troubleshooting.md)

# --- Gradle bootstrap (only used to generate wrappers in new apps) -------
ADX_GRADLE_VERSION="9.8.2"
ADX_GRADLE_SHA256="21bd5da2de49b642904077f38c0efdc7778e92b3ed0889392dca61b97e389607"  # gradle-<ver>-bin.zip; gradle module + app wrappers

# --- Node.js (user-level, for mobile-mcp) ---------------------------------
ADX_NODE_VERSION="26.13.0"   # LTS; installed by the node module if node is missing or too old
ADX_NODE_SHA256="d28a96af6c38596f6d9d97c0ee531c13d238d757742387d1928de822d959e997"  # node-v<ver>-linux-x64.tar.xz (nodejs.org SHASUMS256)
ADX_NODE_MIN_MAJOR="20"

# --- Rust toolchain (rust module; builds aodm) -----------------------------
ADX_RUST_TOOLCHAIN="1.95.0"
ADX_RUSTUP_VERSION="1.29.3"
ADX_RUSTUP_SHA256="b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55"  # rustup-init x86_64-unknown-linux-gnu
ADX_CARGO_HOME="$HOME/.cargo"

# --- Phone image manager (aodm; devices module) ---------------------------
ADX_AOD_HOME="${ADX_AOD_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/aod}"   # images.toml, saves/, templates/, phones/; env override = sandbox
ADX_AOD_SAVES_DIR="${ADX_AOD_SAVES_DIR:-$ADX_AOD_HOME/saves}"
ADX_AOD_MAX_SAVES="3"            # per image; aodm refuses more until you prune (pinned saves exempt)
ADX_AOD_BASE_PORT="5554"         # first console port; instances use base + 2n (adb sees 16 slots)
ADX_AOD_MAX_INSTANCES="3"        # running at once (8 threads, software GPU)
ADX_AOD_RAM_RESERVE_MB="2048"    # host RAM kept free when starting images

# --- Console (console module; local web GUI, Python standard library) ----
ADX_CONSOLE_PORT="8766"      # http://127.0.0.1:<port>; LinSmartPhone uses 8765
ADX_CONSOLE_ASSETS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/adx/assets"   # Assets page library (wallpapers/, media/, sounds/, apps/, screenshots/)
ADX_CONSOLE_UPLOAD_MAX_MB="200"   # largest file the Assets page accepts

# --- Developer tools (devtools module; used by `adx check`) ----------------
ADX_SHELLCHECK_VERSION="0.11.0"
ADX_SHELLCHECK_SHA256="8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"
ADX_CARGO_DENY_VERSION="0.20.2"
ADX_CARGO_DENY_SHA256="9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f"   # x86_64-unknown-linux-musl

# --- mobile-mcp ----------------------------------------------------------
ADX_MOBILE_MCP_VERSION="1.0.16"
ADX_MCP_SCOPE="user"         # user = all projects | local | project

# --- App template (compose-roborazzi) versions ---------------------------
ADX_AGP_VERSION="9.5.1"
ADX_KOTLIN_VERSION="2.4.21"
ADX_COMPOSE_BOM="2026.09.00"
ADX_ACTIVITY_COMPOSE="1.13.0"
ADX_ROBORAZZI_VERSION="1.77.0"
ADX_ROBOLECTRIC_VERSION="4.17"
ADX_ROBOLECTRIC_SDK="36"     # SDK Robolectric renders against
ADX_COMPILE_SDK="37"
ADX_TARGET_SDK="36"
ADX_MIN_SDK="26"
ADX_APP_GIT_INIT="${ADX_APP_GIT_INIT:-true}"
ADX_APP_SKILLS="${ADX_APP_SKILLS:-true}"   # vendor skills from config/skills.manifest into new apps

# --- Android Studio (dormant; kept for when it is needed) ----------------
ADX_STUDIO_HOME="$HOME/.local/opt/android-studio"
